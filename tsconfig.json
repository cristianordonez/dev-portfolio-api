{
    "compilerOptions": {
        "outDir": "dist",
        "sourceMap": true,
        "target": "esnext",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "./*.js",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.*.ts",
        "test/db/teardown.js",
        "test/db/setup.js"
    ]
}
